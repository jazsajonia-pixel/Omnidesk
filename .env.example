# Browser-visible configuration only; never put secrets in VITE_ variables.
VITE_API_BASE_URL=/api

# Server-only values. Copy to .env locally; never commit real credentials.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
APP_ORIGIN=http://localhost:5173
API_PORT=4000

# Optional switches
# DEMO_ENABLED=false        # turn off the one-click demo workspace
# DISABLE_RATE_LIMIT=true   # local QA only; never in production
