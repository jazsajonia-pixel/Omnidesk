{
  "name": "omnidesk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "api:dev": "tsx server.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b --pretty && tsc --project tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke:production": "tsx src/server/production-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@hono/vercel": "^1.0.0",
    "pg": "^8.13.1",
    "better-auth": "1.7.11",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.16",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "minimatch": "11.0.1"
  }
}
